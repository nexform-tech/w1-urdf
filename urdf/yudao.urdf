<?xml version="1.0" encoding="utf-8"?>
<!-- 
    原始 URDF 由 SolidWorks to URDF Exporter 生成，已做以下修改：
    1. 新增一个基座 link "base_link"（作为世界坐标系下的固定基座）。
    2. 将原根 link "XC_link" 通过一个固定关节 "rot_fixed_joint" 连接到 "base_link"，
       并在该关节上施加绕 X 轴旋转 90°（1.57079632679 rad）的变换，
       使整个机器人从原来的 Y 轴向上变为 Z 轴向上。
    这样所有平移轴（prismatic）将沿 Z 方向运动，视觉模型也得到相应旋转。
-->
<robot name="yudao_urdf_z_up">

  <!-- 新增的固定基座，用于整体旋转变换 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.000001" />
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9" />
    </inertial>
  </link>

  <!-- 固定关节，使整个机器人绕 X 轴旋转 +90°，将 Y 轴映射到 Z 轴 -->
  <joint name="rot_fixed_joint" type="fixed">
    <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
    <parent link="base_link" />
    <child link="XC_link" />
  </joint>

